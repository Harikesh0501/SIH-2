# Application Environment
ENVIRONMENT=development
PORT=8000

# Database Configuration
# Local Development (Zero setup required - works offline):
DATABASE_URL=sqlite:///./karmayogi.db
# Cloud Hosting (Paste your Neon.tech or Supabase PostgreSQL connection string here):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# NVIDIA NIM AI Model (Get key from https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini AI API Key (Optional fallback)
GEMINI_API_KEY=

# Security & Authentication
SECRET_KEY=karmayogi_sankhyiki_secret_key_sih26101_secure_token_salt_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# iGOT Karmayogi API Integration Simulation
IGOT_API_BASE_URL=https://igotkarmayogi.gov.in/api/v1
IGOT_MOCK_MODE=true

# Public Base URL for QR Verification links
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
